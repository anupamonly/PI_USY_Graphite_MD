units metal
dimension 3
boundary p p p

atom_style atomic

read_data data/graphite_fixed.data
mass 1 12.011
pair_style airebo 3.0
pair_coeff * * /usr/share/lammps/potentials/CH.airebo C

neighbor 2.0 bin
neigh_modify delay 5

thermo 100

reset_timestep 0

min_style cg
minimize 1e-10 1e-10 10000 100000

write_data outputs/graphite_minimized.data
