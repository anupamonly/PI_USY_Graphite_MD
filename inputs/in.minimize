# ==========================================================
# PI_USY_Graphite_MD
# Energy Minimization
# LAMMPS 10 Dec 2025
# ==========================================================

units           real
dimension       3
boundary        p p p
atom_style      full

# ---------- System ----------

read_data       data/system.data

# ---------- Force Fields ----------
# (These will be expanded as we add CVFF, ClayFF, OPLS-AA, etc.)

pair_style      lj/cut/coul/long 12.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  cvff

special_bonds   lj/coul 0.0 0.0 0.5

kspace_style    pppm 1.0e-4

# ---------- Neighbor ----------

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ---------- Thermo ----------

thermo          100

thermo_style custom \
step temp pe ke etotal press density

# ---------- Dump ----------

dump            traj all custom 1000 \
outputs/minimize.lammpstrj \
id type q x y z

# ---------- Minimization ----------

min_style       cg

minimize        1.0e-6 1.0e-8 5000 100000

write_data      data/minimized.data

print "Energy minimization completed."
