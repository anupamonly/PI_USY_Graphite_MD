  inside box 0. 0. 0. 60. 60. 60.
end structure

structure DMC.xyz
  number 100
  inside box 0. 0. 0. 60. 60. 60.
end structure

structure DEC.xyz
  number 100
  inside box 0. 0. 0. 60. 60. 60.
end structure

structure LiPF6.xyz
  number 20
  inside box 0. 0. 0. 60. 60. 60.
end structure

